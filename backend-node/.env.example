# Server configuration
PORT=8000
NODE_ENV=production

# Supabase Transaction Pooler (Mode: Transaction, Port: 6543)
# Salin dari: Supabase Dashboard > Project Settings > Database > Connection String > Transaction Pooler
# Host format: [region].pooler.supabase.com:6543, User format: postgres.[PROJECT_REF]
# Catatan: URL-encode karakter khusus pada password (misal: # -> %23)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[REGION].pooler.supabase.com:6543/postgres

# CORS Configuration (comma-separated allowed origins)
# If empty, all browser cross-origin requests are rejected
FRONTEND_URL=http://localhost:5173,https://rpl-uts.vercel.app

# Token Expiration (minutes, default 1440 = 24 hours)
TOKEN_TTL_MINUTES=1440

# Optional SSL CA certificate for strict Supabase DB verification
# If omitted, rejectUnauthorized defaults to false for intermediate certificate poolers
# DB_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
